{
  "name": "amazon-ppc-analysis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify:dedup": "npx tsx scripts/verify-dedup-clicks.ts",
    "verify:dedup:cross": "npx tsx scripts/verify-dedup-cross-files.ts",
    "verify:dedup:sp": "npx tsx scripts/verify-dedup-sp-product-targets.ts",
    "verify:dedup:all": "npm run verify:dedup && npm run verify:dedup:cross && npm run verify:dedup:sp",
    "preview": "vite preview",
    "server": "node server/index.js"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.2.2",
    "vite": "^6.4.1"
  }
}
